{
  "name": "dalslandskoren-se",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run build && npm run db:local && wrangler dev --local --ip 127.0.0.1",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "verify": "npm run check && npm test && npm run build && wrangler deploy --dry-run",
    "deploy": "npm run deploy:check && npm run verify && npm run db:remote && wrangler deploy",
    "deploy:public": "npm run deploy:check -- --public-only && npm run verify && npm run db:remote && wrangler deploy",
    "deploy:check": "node scripts/check-deployment.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/mulish": "^5.2.0",
    "jose": "^6.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  }
}
